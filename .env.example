# 应用配置
RELEASEGUARD_ENVIRONMENT=demo
LOG_LEVEL=INFO

# Agent
# fixture 可离线演示；生产模型示例：openai:gpt-5-mini
RELEASEGUARD_MODEL=fixture
OPENAI_API_KEY=
RELEASEGUARD_GATEWAY_MODE=fixture
RELEASEGUARD_GATEWAY_BASE_URL=http://ops-gateway:8081
RELEASEGUARD_GATEWAY_TOKEN=
RELEASEGUARD_CHECKPOINT_PATH=data/agent-checkpoints.sqlite
RELEASEGUARD_ALLOWED_SERVICES=payment-service

# 数据库
POSTGRES_USER=releaseguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=releaseguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 缓存
REDIS_URL=redis://redis:6379/0

# 可观测性
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200
